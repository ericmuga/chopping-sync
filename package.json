{
  "name": "wms-bc-sync-service",
  "version": "1.0.0",
  "description": "WMS to Business Central chopping sync service",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "run-once": "node src/index.js --run-once",
    "service:install": "node scripts/install-service.cjs",
    "service:uninstall": "node scripts/uninstall-service.cjs"
  },
  "dependencies": {
    "mssql": "^10.0.2",
    "node-windows": "^1.0.0-beta.8",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "dotenv": "^16.3.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
